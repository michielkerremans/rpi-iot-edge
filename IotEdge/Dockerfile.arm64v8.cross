# syntax=docker/dockerfile:1.4
# Uses shared SDK base image - build it first:
#   docker build -f ../../Dockerfile.sdk-arm64 -t iotedge-sdk-arm64:latest ../..
ARG SDK_IMAGE=iotedge-sdk-arm64:latest
ARG TARGETPLATFORM=linux/arm64/v8

# Build stage - uses pre-built SDK image (includes pre-extracted runtime libs)
FROM ${SDK_IMAGE} AS build
WORKDIR /app
COPY . .
# Clean any cached CMake files and rebuild from scratch
RUN rm -rf CMakeCache.txt CMakeFiles/ && \
    cmake -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
          -DCMAKE_C_COMPILER=${CC} -DCMAKE_CXX_COMPILER=${CXX} \
          -DCMAKE_SYSROOT=${SYSROOT} \
          -DCMAKE_FIND_ROOT_PATH=${SYSROOT} \
          -DCMAKE_PREFIX_PATH=${SYSROOT}/usr \
          -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
          -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
          -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY . \
    && make -j$(nproc) VERBOSE=1 \
    && aarch64-linux-gnu-strip main

# Helper stage to collect only required libraries
FROM ${SDK_IMAGE} AS deps
COPY --from=build /app/main /tmp/main
# Use ldd-like approach to find dependencies and copy them
RUN mkdir -p /runtime/lib /runtime/usr/lib /runtime/etc /runtime/lib/aarch64-linux-gnu && \
    # Copy dynamic linker
    cp ${SYSROOT}/lib/ld-linux-aarch64.so.1 /runtime/lib/ && \
    # Find and copy all required shared libraries
    aarch64-linux-gnu-readelf -d /tmp/main | grep NEEDED | awk '{print $5}' | tr -d '[]' | while read lib; do \
        find ${SYSROOT}/lib ${SYSROOT}/usr/lib -name "$lib" -exec cp {} /runtime/lib/ \; 2>/dev/null || true; \
    done && \
    # Copy IoT SDK and OpenSSL dependencies transitively
    for libfile in /runtime/lib/*.so*; do \
        if [ -f "$libfile" ]; then \
            aarch64-linux-gnu-readelf -d "$libfile" 2>/dev/null | grep NEEDED | awk '{print $5}' | tr -d '[]' | while read lib; do \
                find ${SYSROOT}/lib ${SYSROOT}/usr/lib -name "$lib" -exec cp {} /runtime/lib/ \; 2>/dev/null || true; \
            done; \
        fi; \
    done && \
    # Copy NSS libraries for DNS resolution
    find ${SYSROOT}/lib/aarch64-linux-gnu ${SYSROOT}/usr/lib/aarch64-linux-gnu -name "libnss_dns*" -o -name "libnss_files*" -o -name "libresolv*" | xargs -I {} cp {} /runtime/lib/aarch64-linux-gnu/ 2>/dev/null || true && \
    # Copy SSL certificates (small but essential) - only if they exist
    mkdir -p /runtime/etc /runtime/usr/share && \
    if [ -d "${SYSROOT}/etc/ssl" ]; then cp -r ${SYSROOT}/etc/ssl /runtime/etc/; fi && \
    if [ -d "${SYSROOT}/usr/share/ca-certificates" ]; then cp -r ${SYSROOT}/usr/share/ca-certificates /runtime/usr/share/; fi && \
    # Create minimal DNS config files
    echo "nameserver 127.0.0.11" > /runtime/etc/resolv.conf && \
    echo "127.0.0.1 localhost" > /runtime/etc/hosts && \
    # Critical: Create nsswitch.conf to enable DNS resolution via NSS \
    echo "hosts: files dns" > /runtime/etc/nsswitch.conf

# Runtime stage (runs on arm64 device)
FROM scratch
# Copy only the libraries we actually need
COPY --from=deps /runtime/lib/*.so* /lib/aarch64-linux-gnu/
COPY --from=deps /runtime/lib/ld-linux-aarch64.so.1 /lib/
COPY --from=deps /runtime/lib/aarch64-linux-gnu/*.so* /lib/aarch64-linux-gnu/
COPY --from=deps /runtime/etc/ssl* /etc/
COPY --from=deps /runtime/etc/resolv.conf /etc/resolv.conf
COPY --from=deps /runtime/etc/hosts /etc/hosts
COPY --from=deps /runtime/etc/nsswitch.conf /etc/nsswitch.conf
COPY --from=deps /runtime/usr/share/* /usr/share/
COPY --from=build /app/main /app/main
CMD ["/app/main"]
